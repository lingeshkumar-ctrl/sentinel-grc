# ================================================================
# Sentinel-GRC Cybersecurity Platform - Environment Configuration
# ================================================================
# Copy this file to '.env' before running docker-compose:
#   cp .env.example .env
# Replace the placeholder values below with your own secure secrets.

# --- Security & JWT ---
# Minimum 32-character secret string used to sign and verify HMAC-SHA256 JWT tokens.
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long

# --- Initial Bootstrap Administrator Credentials ---
# These credentials will be used on first run to seed the initial root admin account.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMeNow!_SecureAdmin2026

# --- Service Ports (Optional Customization) ---
FRONTEND_PORT=80
API_GATEWAY_PORT=8080
IAM_SERVICE_PORT=8081
